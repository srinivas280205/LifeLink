PORT=3456
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lifelink
JWT_SECRET=your_strong_random_secret_here
ADMIN_SECRET=your_admin_secret_here
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=mailto:you@example.com
# Fast2SMS — get free API key at https://fast2sms.com → Dashboard → Dev API
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Phase 1 prototype. Set true for local testing; release checks are still pending.
# Requires MongoDB Atlas or another replica set.
COORDINATION_ENABLED=false
COORDINATION_RADII=5,10,20,50
COORDINATION_NORMAL_WAIT_SECONDS=300
COORDINATION_URGENT_WAIT_SECONDS=120
COORDINATION_CRITICAL_WAIT_SECONDS=45
COORDINATION_DAILY_ALERT_LIMIT=10
COORDINATION_LOCATION_MAX_AGE_SECONDS=86400
COORDINATION_MAX_ACCURACY_METERS=1000
COORDINATION_REQUEST_COOLDOWN_SECONDS=300
